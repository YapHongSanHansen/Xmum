# Copy this file to .env.local (local) or add it to your host's environment variables.
# Never commit your real .env.local file.

# Optional. Lets Bukti read customer replies and slips live with ILMU Mini v3.3
# through Grafilab (hosted in Malaysia). Override the model with GRAFILAB_MODEL.
GRAFILAB_API_KEY=your-grafilab-api-key

# Optional alternative: read with Claude instead (used when GRAFILAB_API_KEY is not set).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Without either key, Bukti uses the cached results for the three demo messages.
